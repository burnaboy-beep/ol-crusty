+            Triple("4", "you (olcrusty)", "428.6"),
+            Triple("5", "tidepool_mo", "7,640"),
+            Triple("6", "shellshock22", "6,980"),
+            Triple("7", "briny_deep", "6,120"),
+            Triple("8", "hermit_hq", "5,875"),
+            Triple("9", "lowtide.lena", "5,410"),
